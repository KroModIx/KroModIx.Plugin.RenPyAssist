<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>KroModIx.Plugin.RenPyAssist</RootNamespace>
    <AssemblyName>KroModIx.Plugin.RenPyAssist</AssemblyName>
    <!-- Plugin-DLL braucht ihre transitiven Dependencies im Bundle
         (SixLabors.ImageSharp für AVIF/WebP → PNG von f95zone-Covers).
         Ohne diese Property landen sie nicht in bin/. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Host-Assemblies: ExcludeAssets=runtime — kommen vom Host mit. -->
    <PackageReference Include="KroModIx.Plugin.Contracts"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="CommunityToolkit.Mvvm"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Plugin-spezifisch: muss ins Bundle. f95zone-Cover kommen als AVIF/
         WebP — Avalonia/Skia versteht die nicht standardmäßig. -->
    <PackageReference Include="SixLabors.ImageSharp" />
    <!-- Python-Pickle-Deserializer fuer RPA-Archive-Index + Save-Files
         (beides Ren'Py Pickle-Format). -->
    <PackageReference Include="Razorvine.Pickle" />
    <!-- Animierte GIF-Cover in Detail-View (v0.11+). -->
    <PackageReference Include="Avalonia.Labs.Gif" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- KrosteMod-Assets: Icons für Cheat/Hint-Screens (v0.6+). Werden
         beim Deploy in den Ren'Py-game/-Ordner geschrieben. -->
    <EmbeddedResource Include="Assets\krostemod_cheat.png" />
    <EmbeddedResource Include="Assets\krostemod_hint.png" />
  </ItemGroup>
</Project>
